# Dependencies
node_modules/

# Build output
dist/
build/

# Environment - never commit real secret values.
# .env.example is the only env file allowed in the repo.
.env
.env.*
!.env.example

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Coverage
coverage/

# Docker volumes
pgdata/

# Local task/brief scratch dirs (not part of codebase)
kes-tasks/

# Tooling JWT for screenshot capture scripts — never commit (CLAUDE.md screenshot protocol)
scripts/.ali_jwt.txt
scripts/.*_jwt.txt
# Local portal magic-link tokens for E2E driver — never commit (contain live tokens)
scripts/.demo_portal_token.txt
scripts/.demo_onboarding_runs.json
scripts/.demo_login_urls.txt

# Personal finance documents - NEVER COMMIT (sensitive PII: SSNs, tax returns, account numbers)
docs/personal-finance/

# Generated operational reports - NEVER COMMIT (student PII: names, emails, payment-failure detail, balances)
docs/reports/

kes-tasks/

# Cron-env-wrapper Basecamp token cache - SECRET, never commit (rotates every 2 weeks)
tmp/ops-engine/bc-token.cache

# Story-Driven Build runtime secrets - SECRET, never commit.
# .bctok (Ali Basecamp token) and .oaikey (advisor OpenAI key) are pulled from the
# prod container at runtime by the story-build skill and wiped after each run.
.bctok
.oaikey

# Local OAuth / API token dumps written by mailbox + auth scripts - SECRET, never commit.
# These sit untracked at the repo root; without these rules a `git add -A` commits live tokens.
*_token.txt
hotmail_*.txt

# loop-architect run state - ephemeral per-run ledgers/logs/dashboards, not source.
.loop-architect/

# Python bytecode - the repo ships Python only inside .claude/skills/*/scripts/,
# and running or compile-checking those leaves __pycache__ noise in the tree.
__pycache__/
*.pyc
