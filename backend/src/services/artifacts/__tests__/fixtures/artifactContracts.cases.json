    { "name": "blank evaluation criteria", "story_id": "S-125", "artifacts": [{ "key": "ART-001", "name": "G", "type": "field_guide", "evaluation_criteria": "" }], "expect_codes": ["evaluation_criteria_blank"], "expect_resolved": 0 },
