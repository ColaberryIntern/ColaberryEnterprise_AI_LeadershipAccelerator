    { "name": "a repo path that climbs out of the repo", "story_id": "S-118", "artifacts": [{ "key": "ART-001", "name": "Report", "type": "analysis_report", "repo_path": "docs/../../a.pdf" }], "expect_codes": ["repo_path_escapes"], "expect_resolved": 0 },
    { "name": "a repo path with no extension cannot be type checked", "story_id": "S-119", "artifacts": [{ "key": "ART-001", "name": "Report", "type": "analysis_report", "repo_path": "docs/report" }], "expect_codes": ["repo_path_no_extension"], "expect_resolved": 0 },
    { "name": "a dotfile is not an extension", "story_id": "S-120", "artifacts": [{ "key": "ART-001", "name": "Report", "type": "analysis_report", "repo_path": "docs/.pdf" }], "expect_codes": ["repo_path_no_extension"], "expect_resolved": 0 },
    { "name": "a repo path whose extension the artifact does not accept", "story_id": "S-121", "artifacts": [{ "key": "ART-001", "name": "Report", "type": "analysis_report", "repo_path": "docs/a.docx" }], "expect_codes": ["repo_path_extension_not_declared"], "expect_resolved": 0 },
    { "name": "a repo path on a platform-only type reads nothing", "story_id": "S-122", "artifacts": [{ "key": "ART-001", "name": "G", "type": "field_guide", "repo_path": "docs/g.html" }], "expect_codes": ["repo_path_on_platform_type"], "expect_resolved": 0 },
