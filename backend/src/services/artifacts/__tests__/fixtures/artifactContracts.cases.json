    { "name": "an absolute posix repo path", "story_id": "S-116", "artifacts": [{ "key": "ART-001", "name": "Report", "type": "analysis_report", "repo_path": "/docs/a.pdf" }], "expect_codes": ["repo_path_absolute"], "expect_resolved": 0 },
