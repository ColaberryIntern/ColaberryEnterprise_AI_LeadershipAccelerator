PORT=3001
DATABASE_URL=postgres://postgres:password@localhost:5432/detroit_voter_education
# 64 hex chars = 32 bytes for AES-256-GCM. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_64_hex_char_key_here
NODE_ENV=development
# Admin API key — required to call GET /api/preferences/:sessionId. Generate: openssl rand -hex 32
ADMIN_API_KEY=your_admin_api_key_here
# STORY-023: HMAC-SHA256 signing key for new audit_log entries (auditLogAgent.js).
# 64 hex chars = 32 bytes. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUDIT_LOG_SIGNING_KEY=your_64_hex_char_key_here
# STORY-024: credential for the data_steward role (app/config/roles.js) --
# required to call GET /api/audit-log/:id. Deliberately distinct from
# ADMIN_API_KEY; holding the general admin key alone does not grant
# audit-log access. Generate: openssl rand -hex 32
DATA_STEWARD_API_KEY=your_data_steward_api_key_here
