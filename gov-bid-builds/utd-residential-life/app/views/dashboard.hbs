<div class="d-flex align-items-center justify-content-between mb-4">
  <div>
    <h2 class="mb-0">Dashboard</h2>
    <p class="text-muted mb-0">Welcome back, {{user.name}}</p>
  </div>
  <a href="/reports/new" class="btn btn-primary">
    <i class="bi bi-plus-lg me-1"></i>New Report
  </a>
</div>

{{#if notifications.length}}
<div class="mb-4">
  {{#each notifications}}
  <div class="alert alert-danger d-flex align-items-center gap-2 py-2 mb-2">
    <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
    <span class="small">
      {{message}}
      {{#if report_id}}
      — <a href="/reports/{{report_id}}" class="alert-link">View Report #{{report_id}}</a>
      {{/if}}
    </span>
  </div>
  {{/each}}
</div>
{{/if}}

<!-- Stat cards -->
<div class="row g-3 mb-4">
  <div class="col-6 col-lg-3">
    <div class="card border-0 shadow-sm stat-card open h-100">
      <div class="card-body">
        <div class="text-muted small mb-1">Open</div>
        <div class="stat-number">{{counts.open_count}}</div>
        <a href="/reports?status=open" class="stretched-link small text-muted">View all →</a>
      </div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="card border-0 shadow-sm stat-card escalated h-100">
      <div class="card-body">
        <div class="text-muted small mb-1">Escalated</div>
        <div class="stat-number text-danger">{{counts.escalated_count}}</div>
        <a href="/reports?status=escalated" class="stretched-link small text-muted">View all →</a>
      </div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="card border-0 shadow-sm stat-card resolved h-100">
      <div class="card-body">
        <div class="text-muted small mb-1">Resolved</div>
        <div class="stat-number text-success">{{counts.resolved_count}}</div>
        <a href="/reports?status=resolved" class="stretched-link small text-muted">View all →</a>
      </div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="card border-0 shadow-sm stat-card total h-100">
      <div class="card-body">
        <div class="text-muted small mb-1">Total Reports</div>
        <div class="stat-number text-primary">{{counts.total_count}}</div>
        <a href="/reports" class="stretched-link small text-muted">View all →</a>
      </div>
    </div>
  </div>
</div>

<div class="row g-4">
  <!-- Recent reports -->
  <div class="col-lg-8">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-transparent d-flex align-items-center justify-content-between py-3">
        <span class="fw-semibold">Recent Reports</span>
        <a href="/reports" class="btn btn-outline-secondary btn-sm">View all</a>
      </div>
      <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
          <thead class="table-light">
            <tr>
              <th class="ps-3" style="width:60px">#</th>
              <th>Type</th>
              <th>Location</th>
              <th>Status</th>
              <th>Filed</th>
            </tr>
          </thead>
          <tbody>
            {{#each recent}}
            <tr onclick="location.href='/reports/{{id}}'" style="cursor:pointer">
              <td class="ps-3 text-muted small">#{{id}}</td>
              <td>
                <i class="bi {{formTypeIcon form_type}} me-1 text-muted"></i>
                <span class="small">{{formTypeLabel form_type}}</span>
              </td>
              <td class="small text-muted">
                {{#if building}}{{building}}{{#if room_number}} · Rm {{room_number}}{{/if}}{{else}}—{{/if}}
              </td>
              <td>
                <span class="badge bg-{{badgeClass status}}">{{statusLabel status}}</span>
              </td>
              <td class="small text-muted">{{formatDate created_at}}</td>
            </tr>
            {{else}}
            <tr>
              <td colspan="5" class="text-center text-muted py-4">
                No reports yet. <a href="/reports/new">File the first one →</a>
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- By type breakdown -->
  <div class="col-lg-4">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-transparent py-3">
        <span class="fw-semibold">By Form Type</span>
      </div>
      <div class="card-body">
        {{#each byType}}
        <div class="d-flex align-items-center justify-content-between py-2 border-bottom">
          <span class="small">
            <i class="bi {{formTypeIcon form_type}} me-2 text-muted"></i>
            {{formTypeLabel form_type}}
          </span>
          <span class="badge bg-light text-dark border">{{cnt}}</span>
        </div>
        {{else}}
        <p class="text-muted small mb-0">No data yet.</p>
        {{/each}}
      </div>
    </div>
  </div>
</div>
