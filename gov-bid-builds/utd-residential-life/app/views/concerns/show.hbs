<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-4">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/concerns">Students of Concern</a></li>
    <li class="breadcrumb-item active">{{flag.resident_name}}</li>
  </ol>
</nav>

{{#if (eq flash "created")}}
<div class="alert alert-success border-0 mb-4">
  <i class="bi bi-check-circle me-2"></i>
  Concern flag submitted. Professional staff have been notified and will follow up within 48 hours.
</div>
{{/if}}
{{#if (eq flash "updated")}}
<div class="alert alert-info border-0 mb-4">
  <i class="bi bi-arrow-repeat me-2"></i>Concern flag updated successfully.
</div>
{{/if}}

<!-- Header -->
<div class="d-flex justify-content-between align-items-start mb-4 gap-3">
  <div>
    <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
      <h2 class="mb-0">{{flag.resident_name}}</h2>
      <span class="badge {{flag.typeBadge}}">
        <i class="bi {{flag.typeIcon}} me-1"></i>{{flag.typeLabel}}
      </span>
      <span class="badge {{flag.urgencyBadge}}">{{flag.urgencyLabel}} urgency</span>
    </div>
    <p class="text-muted small mb-0">
      <i class="bi bi-building me-1"></i>{{flag.building}} &middot;
      <i class="bi bi-door-closed me-1 ms-2"></i>Room {{flag.room}}
    </p>
  </div>
  <div class="text-end flex-shrink-0">
    <span class="badge {{flag.statusBadge}} fs-6 px-3 py-2">{{flag.statusLabel}}</span>
    <div class="text-muted small mt-1">
      <i class="bi bi-clock me-1"></i>{{flag.formattedDate}}
    </div>
  </div>
</div>

<div class="row g-4">

  <!-- Main: description + update form -->
  <div class="col-lg-8">

    <!-- Observation -->
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-light py-2 fw-semibold small">
        <i class="bi bi-eye me-2 text-muted"></i>Observation
      </div>
      <div class="card-body">
        <p class="mb-0">{{flag.description}}</p>
      </div>
    </div>

    {{#if canEdit}}
    <!-- Workflow update form (CC/RD only) -->
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-light py-2 fw-semibold small">
        <i class="bi bi-arrow-clockwise me-2 text-primary"></i>Update Workflow
      </div>
      <div class="card-body">
        <form method="POST" action="/concerns/{{flag.id}}/update">

          <div class="row g-3 mb-3">
            <div class="col-sm-6">
              <label class="form-label small fw-semibold">Status</label>
              <select class="form-select form-select-sm" name="new_status">
                <option value="open"         {{#if flag.isOpen}}selected{{/if}}>Open</option>
                <option value="under_review" {{#if flag.isUnderReview}}selected{{/if}}>Under Review</option>
                <option value="resolved"     {{#if (eq flag.status "resolved")}}selected{{/if}}>Resolved</option>
                <option value="dismissed"    {{#if (eq flag.status "dismissed")}}selected{{/if}}>Dismissed</option>
              </select>
            </div>
            <div class="col-sm-6">
              <label class="form-label small fw-semibold">Assign To</label>
              <select class="form-select form-select-sm" name="assigned_to_id">
                <option value="">— Unassigned —</option>
                {{#each assignees}}
                <option value="{{id}}" {{#if (eq id ../flag.assigned_to_id)}}selected{{/if}}>
                  {{name}} ({{roleLabel role}})
                </option>
                {{/each}}
              </select>
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-semibold">Resolution Notes</label>
            <textarea class="form-control form-control-sm" name="resolution_notes" rows="3"
              placeholder="Describe what action was taken and the outcome…">{{flag.resolution_notes}}</textarea>
          </div>

          <button type="submit" class="btn btn-primary btn-sm">
            <i class="bi bi-check2 me-1"></i>Save Update
          </button>
        </form>
      </div>
    </div>
    {{/if}}

    {{#if flag.resolution_notes}}
    <!-- Resolution -->
    <div class="card border-0 shadow-sm border-start border-4 border-success">
      <div class="card-body">
        <div class="fw-semibold small mb-2">
          <i class="bi bi-check-circle me-2 text-success"></i>
          Resolution
          {{#if flag.resolved_by_name}}<span class="text-muted fw-normal">— by {{flag.resolved_by_name}}</span>{{/if}}
          {{#if flag.resolvedAt}}<span class="text-muted fw-normal small ms-1">{{flag.resolvedAt}}</span>{{/if}}
        </div>
        <p class="mb-0 small">{{flag.resolution_notes}}</p>
      </div>
    </div>
    {{/if}}

  </div>

  <!-- Sidebar: audit trail + quick links -->
  <div class="col-lg-4">

    <!-- Audit trail -->
    <div class="card border-0 shadow-sm mb-3">
      <div class="card-header bg-light py-2 fw-semibold small">
        <i class="bi bi-journal-text me-2 text-muted"></i>Audit Trail
      </div>
      <div class="list-group list-group-flush">
        <div class="list-group-item py-3">
          <div class="d-flex gap-2">
            <i class="bi bi-flag-fill text-danger mt-1 flex-shrink-0"></i>
            <div>
              <div class="small fw-semibold">Flag created</div>
              <div class="text-muted" style="font-size:.78rem">
                By {{flag.flagged_by_name}} · {{flag.formattedDate}}
              </div>
            </div>
          </div>
        </div>

        {{#if flag.assigned_to_name}}
        <div class="list-group-item py-3">
          <div class="d-flex gap-2">
            <i class="bi bi-person-check text-primary mt-1 flex-shrink-0"></i>
            <div>
              <div class="small fw-semibold">Assigned</div>
              <div class="text-muted" style="font-size:.78rem">To {{flag.assigned_to_name}}</div>
            </div>
          </div>
        </div>
        {{/if}}

        {{#if flag.isResolved}}
        <div class="list-group-item py-3">
          <div class="d-flex gap-2">
            <i class="bi bi-check-circle-fill text-success mt-1 flex-shrink-0"></i>
            <div>
              <div class="small fw-semibold">{{flag.statusLabel}}</div>
              <div class="text-muted" style="font-size:.78rem">
                {{#if flag.resolved_by_name}}By {{flag.resolved_by_name}} · {{/if}}
                {{#if flag.resolvedAt}}{{flag.resolvedAt}}{{/if}}
              </div>
            </div>
          </div>
        </div>
        {{/if}}
      </div>
    </div>

    <!-- Quick links -->
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-light py-2 fw-semibold small">
        <i class="bi bi-link-45deg me-2 text-muted"></i>Quick Links
      </div>
      <div class="list-group list-group-flush">
        <a href="/students/{{flag.resident_id}}" class="list-group-item list-group-item-action py-2 small">
          <i class="bi bi-person-vcard me-2 text-primary"></i>View 360 Profile
        </a>
        <a href="/concerns/new?resident_id={{flag.resident_id}}" class="list-group-item list-group-item-action py-2 small">
          <i class="bi bi-flag me-2 text-danger"></i>Add Another Flag
        </a>
        <a href="/concerns" class="list-group-item list-group-item-action py-2 small">
          <i class="bi bi-arrow-left me-2 text-muted"></i>All Concerns
        </a>
      </div>
    </div>

  </div>
</div>
