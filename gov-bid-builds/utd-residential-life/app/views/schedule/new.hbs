<div class="d-flex align-items-center gap-3 mb-4">
  <a href="/schedule{{#if currentWeek}}?week={{currentWeek}}{{/if}}" class="btn btn-outline-secondary btn-sm">
    <i class="bi bi-arrow-left"></i>
  </a>
  <div>
    <h2 class="mb-0">Add Shift</h2>
    <p class="text-muted mb-0 small">Schedule a new shift and notify the assigned staff member.</p>
  </div>
</div>

<div class="row">
  <div class="col-lg-6">
    <div class="card border-0 shadow-sm">
      <div class="card-body">
        <form method="POST" action="/schedule">

          <div class="mb-3">
            <label class="form-label">Shift Type <span class="text-danger">*</span></label>
            <select class="form-select" name="shift_type" required>
              <option value="">Select type…</option>
              <option value="front_desk">Front Desk — daytime reception coverage</option>
              <option value="on_call">On-Call — overnight emergency response</option>
              <option value="ra_duty">RA Duty — daytime RA/CC rounds</option>
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label">Assign To <span class="text-danger">*</span></label>
            <select class="form-select" name="assigned_user_id" required>
              <option value="">Select staff member…</option>
              {{#each staff}}
              <option value="{{id}}">{{name}} — {{roleLabel role}}</option>
              {{/each}}
            </select>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-sm-6">
              <label class="form-label">Start <span class="text-danger">*</span></label>
              <input type="datetime-local" class="form-control" name="start_time" required>
            </div>
            <div class="col-sm-6">
              <label class="form-label">End <span class="text-danger">*</span></label>
              <input type="datetime-local" class="form-control" name="end_time" required>
            </div>
          </div>

          <div class="mb-4">
            <label class="form-label">Notes <span class="text-muted small">(optional)</span></label>
            <textarea class="form-control" name="notes" rows="2"
              placeholder="Coverage area, contact number, special instructions…"></textarea>
          </div>

          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary px-4">
              <i class="bi bi-calendar-plus me-1"></i>Add Shift
            </button>
            <a href="/schedule" class="btn btn-outline-secondary">Cancel</a>
          </div>

        </form>
      </div>
    </div>
  </div>

  <div class="col-lg-6">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-light fw-semibold py-2 small">
        <i class="bi bi-info-circle me-2 text-muted"></i>Shift Types
      </div>
      <div class="card-body small text-muted">
        <p><span class="badge bg-primary me-1">Front Desk</span>
          Daytime coverage at the residential hall front desk. Handles check-ins, packages, and general inquiries.</p>
        <p><span class="badge bg-danger me-1">On-Call</span>
          Overnight emergency response (typically 10 PM – 8 AM). Responds to noise complaints, lockouts, and safety issues.
          On-call logs submitted via the Reports module.</p>
        <p class="mb-0"><span class="badge bg-success me-1">RA Duty</span>
          Daytime RA or CC duty rounds. Checks common areas, assists residents, and documents observations.</p>
      </div>
    </div>
  </div>
</div>
