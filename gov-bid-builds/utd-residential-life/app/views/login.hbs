<div class="min-vh-100 d-flex align-items-center justify-content-center" style="padding-top:56px">
  <div class="login-card card border-0 shadow">
    <div class="card-body p-5">

      <div class="text-center mb-4">
        <div class="login-icon mb-3">
          <i class="bi bi-building-fill fs-1 text-primary"></i>
        </div>
        <h4 class="fw-bold mb-1">UTD Residential Life</h4>
        <p class="text-muted small mb-0">
          Demo environment — select any account to continue
          <span class="badge bg-warning text-dark ms-1">Demo</span>
        </p>
      </div>

      <form method="POST" action="/login">
        <div class="user-list mb-4">
          {{#each users}}
          <label class="user-card d-block border rounded p-3 mb-2 cursor-pointer" for="u{{id}}">
            <div class="d-flex align-items-center gap-3">
              <input class="form-check-input mt-0 flex-shrink-0" type="radio"
                     name="user_id" value="{{id}}" id="u{{id}}">
              <div class="flex-grow-1 min-w-0">
                <div class="fw-semibold">{{name}}</div>
                <div class="text-muted small">{{roleLabel role}}{{#if building}} · {{building}}{{/if}}</div>
              </div>
            </div>
          </label>
          {{/each}}
        </div>

        <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
          <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
        </button>
      </form>

    </div>
  </div>
</div>
