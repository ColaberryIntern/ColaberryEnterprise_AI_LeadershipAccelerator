<div class="d-flex align-items-center justify-content-between mb-4">
  <h2 class="mb-0">Reports</h2>
  <a href="/reports/new" class="btn btn-primary">
    <i class="bi bi-plus-lg me-1"></i>New Report
  </a>
</div>

<div class="card border-0 shadow-sm mb-3">
  <div class="card-body py-2">
    <form method="GET" action="/reports" class="d-flex align-items-center gap-2 flex-wrap">
      <select name="type" class="form-select form-select-sm" style="width:auto">
        {{#each typeOptions}}
        <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
        {{/each}}
      </select>
      <select name="status" class="form-select form-select-sm" style="width:auto">
        {{#each statusOptions}}
        <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
        {{/each}}
      </select>
      <button type="submit" class="btn btn-sm btn-outline-secondary">Filter</button>
      {{#if hasFilter}}
      <a href="/reports" class="btn btn-sm btn-link text-muted">Clear</a>
      {{/if}}
    </form>
  </div>
</div>

<div class="card border-0 shadow-sm">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th class="ps-3" style="width:60px">#</th>
          <th>Form Type</th>
          <th>Location</th>
          <th>Status</th>
          <th>Reporter</th>
          <th>Filed</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {{#each reports}}
        <tr>
          <td class="ps-3 text-muted small">#{{id}}</td>
          <td>
            <i class="bi {{formTypeIcon form_type}} me-1 text-muted"></i>
            <span class="small">{{formTypeLabel form_type}}</span>
          </td>
          <td class="small text-muted">
            {{#if building}}
              {{building}}{{#if room_number}} · Rm {{room_number}}{{/if}}
            {{else}}—{{/if}}
          </td>
          <td>
            <span class="badge bg-{{badgeClass status}}">{{statusLabel status}}</span>
            {{#if escalation_reason}}
            <i class="bi bi-exclamation-triangle-fill text-danger ms-1" title="{{escalation_reason}}"></i>
            {{/if}}
          </td>
          <td class="small">{{reporter_name}}</td>
          <td class="small text-muted">{{formatDate created_at}}</td>
          <td>
            <a href="/reports/{{id}}" class="btn btn-sm btn-outline-secondary py-0">View</a>
          </td>
        </tr>
        {{else}}
        <tr>
          <td colspan="7" class="text-center text-muted py-5">
            No reports found.
            {{#unless hasFilter}}
            <a href="/reports/new">File the first one →</a>
            {{/unless}}
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
  {{#if reports.length}}
  <div class="card-footer text-muted small text-end py-2">
    {{reports.length}} report(s) shown
  </div>
  {{/if}}
</div>
