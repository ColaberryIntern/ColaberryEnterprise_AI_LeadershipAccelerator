<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{title}} — UTD Residential Life</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
</head>
<body class="{{#unless user}}bg-light{{/unless}}">

<nav class="navbar app-nav px-4">
  <a class="navbar-brand fw-bold text-white" href="/">
    <i class="bi bi-building me-2"></i>UTD Residential Life
  </a>
  {{#if user}}
  <div class="d-flex align-items-center gap-3">
    <div class="text-white-50 small text-end">
      <div class="text-white fw-semibold">{{user.name}}</div>
      <div>{{roleLabel user.role}}</div>
    </div>
    <form method="POST" action="/logout" class="mb-0">
      <button type="submit" class="btn btn-sm btn-outline-light">Sign out</button>
    </form>
  </div>
  {{/if}}
</nav>

{{#if user}}
<div class="d-flex app-body">

  <aside class="sidebar py-3 flex-shrink-0">
    <nav class="nav flex-column px-2">
      <a class="nav-link" href="/"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a>
      <a class="nav-link" href="/schedule"><i class="bi bi-calendar3 me-2"></i>Schedule</a>
      <a class="nav-link" href="/reports"><i class="bi bi-file-earmark-text me-2"></i>All Reports</a>
      <a class="nav-link" href="/reports/new"><i class="bi bi-plus-circle me-2"></i>New Report</a>

      <div class="nav-divider my-2"></div>
      <div class="nav-section-label px-2 mb-1">Quick File</div>

      <a class="nav-link nav-link-sm" href="/reports/new?type=noise_complaint">
        <i class="bi bi-volume-up me-2 text-warning"></i>Noise Complaint
      </a>
      <a class="nav-link nav-link-sm" href="/reports/new?type=lockout">
        <i class="bi bi-lock me-2 text-primary"></i>Lockout
      </a>
      <a class="nav-link nav-link-sm" href="/reports/new?type=on_call_log">
        <i class="bi bi-journal-text me-2 text-success"></i>On-Call Log
      </a>
      <a class="nav-link nav-link-sm" href="/reports/new?type=roommate_agreement">
        <i class="bi bi-people me-2 text-info"></i>Roommate Agreement
      </a>
      <a class="nav-link nav-link-sm" href="/reports/new?type=evaluation">
        <i class="bi bi-star me-2 text-danger"></i>Evaluation
      </a>
    </nav>
  </aside>

  <main class="main-content flex-grow-1 p-4">
    {{{body}}}
  </main>

</div>
{{else}}
{{{body}}}
{{/if}}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
