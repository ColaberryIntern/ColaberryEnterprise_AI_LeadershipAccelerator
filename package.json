{
  "name": "colaberry-ai-accelerator",
  "version": "1.0.0",
  "private": true,
  "description": "Colaberry Enterprise AI Leadership Accelerator",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run start --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "validate:boundaries": "node scripts/validate-app-boundaries.js",
    "build:apps": "node apps/cpn-public/build.js && node apps/ai-flotation-public/build.js && node apps/refactored-public/build.js",
    "dev:setup": "bash scripts/dev-setup.sh",
    "seed:admin": "npm run seed:admin --workspace=backend",
    "seed:students": "npm run seed:students --workspace=backend",
    "seed:github": "npm run seed:github --workspace=backend",
    "prepare": "git config core.hooksPath .githooks || true",
    "secrets:scan": "node scripts/secret-scan-run.js staged",
    "secrets:scan:tree": "node scripts/secret-scan-run.js tree",
    "secrets:history": "node scripts/secret-scan-run.js history"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "imapflow": "^1.3.3",
    "playwright": "^1.58.2"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "adm-zip": "^0.5.17",
    "pdfkit": "^0.18.0",
    "sharp": "^0.33.5",
    "typescript-language-server": "^5.2.0"
  }
}
